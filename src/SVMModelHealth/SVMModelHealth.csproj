<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitTargetFramework Condition="'$(RevitTargetFramework)' == '' and '$(RevitYear)' == '2027'">net10.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitTargetFramework)' == ''">net8.0-windows</RevitTargetFramework>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
        <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SVMModelHealth</AssemblyName>
    <RootNamespace>SVMModelHealth</RootNamespace>
    <Version>0.6.16</Version>
    <AssemblyVersion>0.6.16.0</AssemblyVersion>
    <FileVersion>0.6.16.0</FileVersion>
    <RevitYear Condition="'$(RevitYear)' == ''">2025</RevitYear>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\health-rules.json" Link="health-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\model-health-16.png" Link="assets\model-health-16.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\model-health-32.png" Link="assets\model-health-32.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\model-health-64.png" Link="assets\model-health-64.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
